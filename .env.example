# Backend Settings
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL when using prod profile)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloud_ai_testing
DB_USER=postgres
DB_PASSWORD=postgres_secure_password

# AWS Credentials (for S3 and Bedrock)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# AI Integration Settings
AI_PROVIDER=bedrock # options: bedrock, mock
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
AI_API_KEY=your_api_key_if_using_alternative_provider
