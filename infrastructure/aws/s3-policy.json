{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowApiServerAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:role/aiTestingApiTaskRole"
        ]
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::ai-testing-platform-workspaces/*"
    },
    {
      "Sid": "AllowTestExecutorAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:role/aiTestingExecutorTaskRole"
        ]
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::ai-testing-platform-workspaces/*"
      ]
    },
    {
      "Sid": "EnforceHttpsOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::ai-testing-platform-workspaces",
        "arn:aws:s3:::ai-testing-platform-workspaces/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
